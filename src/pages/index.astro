---
// Homepage — content comes from src/data/pages/index.json through the Tina
// client, so the body can be edited by clicking it in the visual editor.
// The other 101 pages still use the migrated headHtml/bodyHtml strings.
import Layout from '../layouts/Layout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HomeBody from '../components/islands/HomeBody.astro';
import { business } from '../config/business';
import { getHome } from '../lib/data';

const result = await getHome();
const data = result.data.home;
const seo = data.seo;

// Suburb list drives both the chips and areaServed here, so the two
// can no longer drift apart. Edit it in src/config/business.ts.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  telephone: '+61731446777',
  email: business.email,
  url: business.url,
  areaServed: [...business.areasServed],
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Logan Central',
    addressRegion: 'QLD',
    postalCode: '4114',
    addressCountry: 'AU',
  },
};
---
<Layout>
<Fragment slot="head">
<title>{seo.title}</title>
<meta name="description" content={seo.description}>
<link rel="canonical" href={business.url}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:type" content="website">
<meta property="og:title" content={seo.title}>
<meta property="og:description" content={seo.description}>
<meta property="og:url" content={business.url}>
<meta property="og:locale" content="en_AU">
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={'\n' + JSON.stringify(schema, null, 2) + '\n'}></script>
</Fragment>

<TinaIsland name="home" wrapper={{ tag: 'div' }} primary>
  <HomeBody data={data} />
</TinaIsland>
</Layout>
