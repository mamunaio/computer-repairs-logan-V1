---
import ActiveDeterrenceShowcase from '../../components/cctv-security-cameras-logan/ActiveDeterrenceShowcase.astro';
import Faq from '../../components/cctv-security-cameras-logan/Faq.astro';
import FeaturedAwards from '../../components/cctv-security-cameras-logan/FeaturedAwards.astro';
import Footer from '../../components/cctv-security-cameras-logan/Footer.astro';
import Header from '../../components/cctv-security-cameras-logan/Header.astro';
import Hero from '../../components/cctv-security-cameras-logan/Hero.astro';
import Inclusions from '../../components/cctv-security-cameras-logan/Inclusions.astro';
import InstallerProfile from '../../components/cctv-security-cameras-logan/InstallerProfile.astro';
import LocalCaseStudy from '../../components/cctv-security-cameras-logan/LocalCaseStudy.astro';
import MasterCablerSection from '../../components/cctv-security-cameras-logan/MasterCablerSection.astro';
import MobileAppViewer from '../../components/cctv-security-cameras-logan/MobileAppViewer.astro';
import PricingPackages from '../../components/cctv-security-cameras-logan/PricingPackages.astro';
import ProcessSteps from '../../components/cctv-security-cameras-logan/ProcessSteps.astro';
import QuoteForm from '../../components/cctv-security-cameras-logan/QuoteForm.astro';
import Reviews from '../../components/cctv-security-cameras-logan/Reviews.astro';
import ServicesGrid from '../../components/cctv-security-cameras-logan/ServicesGrid.astro';
import LoganServiceArea from '../../components/cctv-security-cameras-logan/LoganServiceArea.astro';
import SuburbGrid from '../../components/cctv-security-cameras-logan/SuburbGrid.astro';
import SystemComparison from '../../components/cctv-security-cameras-logan/SystemComparison.astro';
import TrustBadges from '../../components/cctv-security-cameras-logan/TrustBadges.astro';
import WomBadges from '../../components/cctv-security-cameras-logan/WomBadges.astro';
import CctvLayout from '../../layouts/CctvLayout.astro';
import { fetchContent } from '../../lib/content-client';

const content = await fetchContent('logan');
---

<CctvLayout 
  title={`${content.seo.title} | Computer Repairs Logan`} 
  description={content.seo.description}
>
  <Header />
  <Hero 
    heading={content.hero.heading}
    subheading={content.hero.subheading}
    description={content.hero.description}
    bullet_1={content.hero.bullet_1}
    bullet_2={content.hero.bullet_2}
    bullet_3={content.hero.bullet_3}
  />
  <TrustBadges />
  <MasterCablerSection />
  <FeaturedAwards />
  <ServicesGrid />
  <ActiveDeterrenceShowcase />
  <MobileAppViewer />
  <Inclusions />
  <SystemComparison />
  <PricingPackages />
  <ProcessSteps />
  <LocalCaseStudy />
  <InstallerProfile />
  <Reviews />
  <SuburbGrid />
  <Faq />
  <QuoteForm />
  <WomBadges />
  <LoganServiceArea />
  <Footer />
</CctvLayout>
