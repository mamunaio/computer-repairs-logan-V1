---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bodyScripts from '../data/body-scripts.html?raw';
import sharedHead from '../data/head.html?raw';

// headHtml/bodyHtml are the migrated raw-HTML pages (101 of them).
// Pages built from structured data instead leave them unset and use the
// "head" and default slots, so the two styles can coexist during the
// gradual move off raw HTML.
interface Props {
  headHtml?: string | null;
  bodyHtml?: string | null;
  footerHtml?: string | null;
  bare?: boolean;
}
const { headHtml = null, bodyHtml = null, footerHtml = null, bare = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{headHtml ? <Fragment set:html={headHtml} /> : <slot name="head" />}
<Fragment set:html={sharedHead} />
</head>
<body>
{bare ? (
  bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />
) : (
  <Fragment>
    <Header />
    {bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />}
    {footerHtml ? <Fragment set:html={footerHtml} /> : <Footer />}
    <Fragment set:html={bodyScripts} />
  </Fragment>
)}
</body>
</html>
